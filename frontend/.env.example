# ==========================================
# TrekHub 前端配置文件
# 部署时请复制此文件为 .env 并修改相应配置
# Vite 要求 VITE_ 前缀才能暴露给客户端代码
# ==========================================

# ---------- 后端 API 地址 ----------
VITE_API_BASE_URL=http://localhost:3000

# ---------- 高德地图 ----------
# 获取地址：https://console.amap.com/dev/key/app
VITE_AMAP_KEY=你的高德Key
VITE_AMAP_SECURITY_CODE=你的安全密钥
