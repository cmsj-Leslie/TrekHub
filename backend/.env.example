# ==========================================
# TrekHub 后端配置文件
# 部署时请复制此文件为 .env 并修改相应配置
# ==========================================

# ---------- 数据库（MySQL） ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trekhub
DB_USER=root
DB_PASS=123456

# ---------- JWT 身份认证 ----------
JWT_SECRET=trekhub_jwt_secret_2025
JWT_EXPIRES=7d

# ---------- DeepSeek AI 大模型 ----------
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- 高德地图 ----------
# 获取地址：https://console.amap.com/dev/key/app
AMAP_KEY=你的高德Key
AMAP_SECURITY_CODE=你的安全密钥

# ---------- 服务器 ----------
PORT=3000
UPLOAD_DIR=uploads
